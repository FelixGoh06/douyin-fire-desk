# This file is generated by scripts/setup-openclaw.sh.
DOUYIN_FIRE_ENV_FILE=/etc/douyin-fire-desk-agent.env
OPENCLAW_COMMAND=/absolute/path/to/openclaw
OPENCLAW_CHANNEL=openclaw-weixin
# WeChat recipient ids end in @im.wechat. The setup script discovers it after pairing.
OPENCLAW_NOTIFY_TARGET=your-recipient-id@im.wechat
