APP_NAME=Douyin Fire Desk
HOST=127.0.0.1
PORT=7788
BASE_PATH=
APP_TIMEZONE=Asia/Shanghai
DATABASE_PATH=/var/lib/douyin-fire-desk/admin.db

ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password
SESSION_SECRET=replace-with-at-least-32-random-characters
COOKIE_ENCRYPTION_KEY=replace-with-a-fernet-key
SESSION_SECURE=0

RUNNER_ENABLED=1
BROWSER_BIN=
BROWSER_HEADLESS=1
PLAYWRIGHT_BROWSERS_PATH=/opt/douyin-fire-desk/.playwright
USE_XVFB=1
CALLBACK_ONLY_LOOPBACK=1
AGENT_API_TOKEN=replace-with-a-random-token
